---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
// Animated SVG built with castwright from site/captures/crawl.terminal.yaml (a recorded real run).
import crawlSvg from '../../captures/crawl.svg?url';
import Diagram from '../components/Diagram.astro';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;

const quickstart = `site-scraper https://www.example.com --max-depth 2
open output/www.example.com/index.html`;
---

<Base>
  <Hero
    title="Take a website with you."
    lead="site-scraper copies a website into a folder that opens without a server: pages, stylesheets, scripts, fonts and images, with every link pointing to the local files. It also takes full-page screenshots of one URL or a whole list."
  >
    <Install
      commands={[
        {
          label: 'macOS · Linux',
          command: 'curl -fsSL https://raw.githubusercontent.com/casoon/site-scraper/main/install.sh | bash',
        },
        {
          label: 'cargo',
          command: 'cargo install --git https://github.com/casoon/site-scraper --features headless',
        },
      ]}
    />
    <Badges>
      <Badge>Free · MIT</Badge>
      <Badge>v{config.version}</Badge>
      <Badge>Rust CLI</Badge>
      <Badge>macOS · Linux</Badge>
    </Badges>
    <img
      slot="output"
      class="terminal-demo"
      src={crawlSvg}
      width="561.6"
      height="296"
      alt="Terminal: site-scraper https://casoon.dev --max-depth 1 --no-sitemap prints 'Crawling https://casoon.dev/', saves https://casoon.dev/ as index.html and https://casoon.dev/en/ as en/index.html, fills a progress bar to 3/3 and ends with 'https://casoon.dev/ → output/casoon.dev' and 'Pages: 3, Failed: 0, Warnings: 0, Duration: 2s'. ls output/casoon.dev then lists _astro, en, fonts and index.html."
    />
  </Hero>

  <Features
    heading="What it is for"
    items={[
      {
        title: 'Before a relaunch',
        body: 'Moving a client site from WordPress, TYPO3 or another CMS? Keep a complete copy of the old site as a reference for content and layout, as plain files you can open, pass on or archive, whether or not the old system stays online.',
      },
      {
        title: 'Sites that need JavaScript',
        body: 'With --headless the pages are rendered in your local Chrome first, so content from React, Vue or other client-side frameworks ends up in the copy.',
      },
      {
        title: 'Screenshots in bulk',
        body: 'site-scraper screenshot captures full-page PNGs of one URL or a list, in desktop, tablet or mobile size, for design reviews and before/after comparisons.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '36', label: 'pages of casoon.de copied in 14 s, 0 failed' },
      { value: '3', label: 'ways to handle images: originals, local or external placeholders' },
      { value: '3', label: 'screenshot sizes: desktop, tablet, mobile' },
      { value: '3', label: 'prebuilt releases: Linux x86_64 and arm64, macOS arm64' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        You give site-scraper a start URL. It reads the site's sitemap as well, fetches each page,
        downloads what the page needs and rewrites every reference so that it points to the local
        copy. The page lands in <code>output/&lt;domain&gt;/</code> under the same path it had on
        the web.
      </p>
      <p>
        Links to other pages of the same site go back into the queue, one level deeper each time,
        until the depth you chose is reached. A short pause between requests keeps the load on the
        site low, and a summary at the end tells you what was saved and what failed.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 340, height: 600 }} />
    <div class="links">
      <Button href={url('docs/guides/how-a-crawl-works/')} variant="secondary">How a crawl works in detail</Button>
      <Button href={url('docs/guides/headless-and-screenshots/')} variant="secondary">Headless mode and screenshots</Button>
      <Button href={url('docs/reference/cli/')} variant="quiet">All options →</Button>
    </div>
  </section>

  <Quickstart
    lead="Install it, point it at a site and open the copy. Given only a URL, site-scraper asks for depth, images and mode in a short menu."
    steps={[
      'Install it with one of the lines above; headless mode and screenshots also need Chrome or Chromium.',
      'Run <code>site-scraper</code> with the URL of the site.',
      'Open <code>output/&lt;domain&gt;/index.html</code> in your browser.',
    ]}
  >
    <CodeBlock code={quickstart} lang="sh" label="Two commands" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Do I need Chrome or Chromium installed?',
        a: 'Only for --headless and for the screenshot subcommand, which both render with a local Chrome or Chromium. The default crawl is plain HTTP and needs nothing beyond site-scraper itself.',
      },
      {
        q: 'How do I verify a downloaded release binary is genuine?',
        a: "Check it against the release's SHA256SUMS and its signed build provenance attestation with gh attestation verify. install.sh does both automatically before installing.",
      },
      {
        q: "Does the crawl follow a site's sitemap?",
        a: 'By default, yes: robots.txt, sitemap.xml, sitemap_index.xml and wp-sitemap.xml are read as extra seed URLs, including gzipped sitemaps, and can be turned off with --no-sitemap.',
      },
      {
        q: 'What happens if a page or screenshot fails?',
        a: "It's reported with its status and the run continues; the overall exit code is 1 if anything failed, so scripts and CI can still detect it.",
      },
    ]}
  />
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
